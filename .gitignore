# ── Secrets & credentials — NEVER commit ────────────────────────────
.env
.env.*
# Example files carry no values and document what a fresh clone must supply.
!.env*.example
*.pem
*.key
credentials
secrets.json
plaid_*.json

# ── Terraform ───────────────────────────────────────────────────────
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
override.tf
override.tf.json
# Saved plan files are binary, environment-specific, and can embed resource
# attributes — never commit them.
tfplan
*.tfplan

# ── Python ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
build/
.coverage
htmlcov/

# ── Lambda build artifacts ──────────────────────────────────────────
*.zip
backend/build/
backend/layers/

# ── Node / frontend ─────────────────────────────────────────────────
node_modules/
frontend/dist/
*.tsbuildinfo
.vite/
*.local

# ── Real financial data — never commit ──────────────────────────────
data/samples/real/
*.csv
!data/samples/*.example.csv

# ── OS / editor ─────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp
.build/
